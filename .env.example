# Copy to .env and fill in for this machine.  common/paths.py reads it; real environment variables win.

# Isaac Sim 6.0.1 launcher (runs sim/sim_server.py)
ISAAC_PYTHON=~/isaacsim/python.sh
# Python of the TRELLIS v1 environment (runs generate/trellis_run.py)
TRELLIS_PYTHON=~/trellis/.venv/bin/python
# Folder holding TRELLIS/ (source), cache/ (HF + torch hub, incl. DINOv2), trellis_weights.json, cuda-12.4/
TRELLIS_ROOT=~/trellis
# Optional: Python for the brain / register / video / eval stages (default: <repo>/.venv/bin/python)
# BRAIN_PYTHON=

# FR3 + three-finger hand asset and finger pose table (scene configs use ${ROBOT_USD} / ${GRIPPER_POSES})
ROBOT_USD=~/三爪/assets/robots/fr3_3finger/v2_frankaFR3_3Fingers.usdz
GRIPPER_POSES=~/三爪/config/gripper_poses.json
# Colon-separated roots searched for isaac://<path> object assets (the Isaac 6.0 asset tree: Isaac/, NVIDIA/)
ISAAC_ASSET_ROOTS=~/isaac_assets/Assets/Isaac/6.0
